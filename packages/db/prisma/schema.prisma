generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  CLIENT_ADMIN
  INVESTIGATOR
  MEDICAL_AUDIT_REVIEWER
  QC_REVIEWER
  RECOVERY_TEAM
  FINANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  NEW
  ASSIGNED
  INVESTIGATION
  EVIDENCE_SUBMITTED
  AUDIT
  QC
  REPORT_APPROVED
  CLIENT_ACTION
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClaimType {
  CASHLESS
  REIMBURSEMENT
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       User[]

  @@map("roles")
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  companyName String   @map("company_name")
  email       String   @unique
  slaTatDays  Int      @map("sla_tat_days")
  billingTier String   @map("billing_tier")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       User[]
  cases       Case[]

  @@map("clients")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  roleId           String     @map("role_id") @db.Uuid
  clientId         String?    @map("client_id") @db.Uuid
  email            String     @unique
  passwordHash     String     @map("password_hash")
  passwordHistory  Json       @default("[]") @map("password_history")
  passwordExpiresAt DateTime  @map("password_expires_at") @db.Timestamptz(6)
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  status           UserStatus @default(ACTIVE)
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  mfaSecret        String?    @map("mfa_secret")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockoutExpiry    DateTime?  @map("lockout_expiry") @db.Timestamptz(6)
  isDeleted        Boolean    @default(false) @map("is_deleted")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  role             Role       @relation(fields: [roleId], references: [id])
  client           Client?    @relation(fields: [clientId], references: [id])
  createdCases     Case[]     @relation("CaseCreator")
  assignments      Assignment[] @relation("AssignedInvestigator")
  assignedBy       Assignment[] @relation("AssignmentCreator")
  statusChanges    CaseStatusHistory[]
  sessions         UserSession[]

  @@index([clientId, roleId])
  @@map("users")
}

model Hospital {
  id                 String     @id @default(uuid()) @map("hospital_id") @db.Uuid
  name               String
  registrationNumber String?    @unique @map("registration_number")
  address            String?
  city               String?
  state              String?
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  providers          Provider[]

  @@map("hospitals")
}

model Provider {
  id         String   @id @default(uuid()) @map("provider_id") @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  name       String
  type       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  cases      Case[]

  @@map("providers")
}

model Claimant {
  id        String   @id @default(uuid()) @map("claimant_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cases     Case[]

  @@map("claimants")
}

model Case {
  id           String     @id @default(uuid()) @map("case_id") @db.Uuid
  clientId     String     @map("client_id") @db.Uuid
  claimantId   String     @map("claimant_id") @db.Uuid
  providerId   String     @map("provider_id") @db.Uuid
  createdById  String     @map("created_by") @db.Uuid
  claimNumber  String     @map("claim_number")
  policyNumber String     @map("policy_number")
  claimType    ClaimType  @map("claim_type")
  claimAmount  Decimal    @map("claim_amount") @db.Decimal(15, 2)
  priority     Priority
  riskLevel    RiskLevel? @map("risk_level")
  status       CaseStatus @default(NEW)
  dueDate      DateTime?  @map("due_date") @db.Date
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  client       Client     @relation(fields: [clientId], references: [id])
  claimant     Claimant   @relation(fields: [claimantId], references: [id])
  provider     Provider   @relation(fields: [providerId], references: [id])
  createdBy    User       @relation("CaseCreator", fields: [createdById], references: [id])
  assignments  Assignment[]
  statusHistory CaseStatusHistory[]

  @@unique([clientId, claimNumber])
  @@index([clientId, status])
  @@index([priority, status])
  @@index([riskLevel, status])
  @@map("cases")
}

model Assignment {
  id             String           @id @default(uuid()) @map("assignment_id") @db.Uuid
  caseId         String           @map("case_id") @db.Uuid
  investigatorId String           @map("investigator_id") @db.Uuid
  assignedById   String           @map("assigned_by") @db.Uuid
  dueDate        DateTime?        @map("due_date") @db.Date
  status         AssignmentStatus @default(PENDING)
  priority       Priority
  notes          String?
  assignedAt     DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  case           Case             @relation(fields: [caseId], references: [id])
  investigator   User             @relation("AssignedInvestigator", fields: [investigatorId], references: [id])
  assignedBy     User             @relation("AssignmentCreator", fields: [assignedById], references: [id])

  @@index([investigatorId, status])
  @@index([caseId])
  @@map("assignments")
}

model CaseStatusHistory {
  id           String     @id @default(uuid()) @map("history_id") @db.Uuid
  caseId       String     @map("case_id") @db.Uuid
  fromStatus   CaseStatus @map("from_status")
  toStatus     CaseStatus @map("to_status")
  changedById  String     @map("changed_by") @db.Uuid
  changeReason String?    @map("change_reason")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  case         Case       @relation(fields: [caseId], references: [id])
  changedBy    User       @relation(fields: [changedById], references: [id])

  @@index([caseId, createdAt])
  @@map("case_status_history")
}

model UserSession {
  id             String   @id @default(uuid()) @map("session_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @map("token_hash")
  ipAddress      String   @map("ip_address") @db.Inet
  userAgent      String   @map("user_agent")
  isActive       Boolean  @default(true) @map("is_active")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, isActive])
  @@map("user_sessions")
}
